FROM maven:3.9-eclipse-temurin-17 AS maven-base

FROM python:3.13-slim

# Install git (required by Smart Tests CLI)
RUN apt-get update && \
    apt-get install -y git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy Java from the maven image
COPY --from=maven-base /opt/java/openjdk /opt/java/openjdk

# Set environment variables for Java
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Install smart-tests-cli
RUN pip3 install --no-cache-dir smart-tests-cli~=2.0

# Verify installations
RUN java -version && \
    python3 --version && \
    git --version && \
    smart-tests --version
